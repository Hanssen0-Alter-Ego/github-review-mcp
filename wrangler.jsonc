{
  "name": "github-review-mcp",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_REPOS": "",
    "GITHUB_ACTOR_ID": ""
  },
  "d1_databases": [{
    "binding": "RECEIPTS",
    "database_name": "github-review-mcp",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
